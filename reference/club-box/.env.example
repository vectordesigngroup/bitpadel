# Copy to .env and fill in. This file has no real secrets.
# Generate tokens locally, for example: openssl rand -hex 24

HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/club.sqlite
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Local currency for slot prices. Amounts elsewhere are integer minor units.
# CURRENCY_DECIMALS is how many digits sit after the major unit (2 when the currency uses cents).
CURRENCY=
CURRENCY_DECIMALS=

# Optional default for the admin slot helper. Leave empty to type a price every time.
DEFAULT_SLOT_PRICE_MINOR=

# Sats per one minor currency unit. Required for LNbits. Optional for the mock backend.
# BTCPay invoices in CURRENCY and does its own conversion, so this can stay empty.
SATS_PER_MINOR_UNIT=

HOLD_MINUTES=15

# mock | btcpay | lnbits
PAYMENT_BACKEND=mock

BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
# Greenfield Lightning method id. Some servers use BTC-LightningNetwork.
BTCPAY_PAYMENT_METHOD=BTC-LN

LNBITS_URL=
LNBITS_INVOICE_KEY=
# 16-128 letters, numbers, underscore, or hyphen. It is part of the webhook path.
LNBITS_WEBHOOK_SECRET=

# mock | http | gpio | serial
# http talks to examples/http-relay. gpio and serial only pulse entry.
# Fire-alarm release stays on hardware. This software never blocks egress.
DOOR_BACKEND=mock
DOOR_HTTP_URL=
DOOR_HTTP_TOKEN=
# Entry pulse length in milliseconds. Capped at 10000.
DOOR_PULSE_MS=3000
DOOR_HTTP_TIMEOUT_MS=2000

# LNURL-auth challenge lifetime. Short on purpose.
K1_TTL_SECONDS=90
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=30
CHALLENGE_RATE_LIMIT_MAX=120

# Required. openssl rand -hex 24
ADMIN_TOKEN=

# Area ids the kiosk may open. Lowercase letters, numbers, hyphens.
ACCESS_AREAS=lounge,after-hours
# Optional local hours. Empty means the area is allowed any time the server is up.
# Example shape, with your own hours: after-hours=18:00-22:00
ACCESS_AREA_HOURS=
CLUB_TIMEZONE=UTC

# Access-log retention. Old challenges are deleted on the same schedule.
LOG_RETENTION_DAYS=90

# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Optional. Staff desk accepts this or the admin token. At least 16 characters.
STAFF_TOKEN=

# Guests per member. Empty means 0 until you set a cap. A member profile can override it.
GUEST_LIMIT=
# Open check-ins older than this are checked out on the desk sweep.
CHECKIN_STALE_MINUTES=480
# Visit and imported-booking retention. Marketing consents are not deleted on this timer.
VISIT_RETENTION_DAYS=30
MEMBERSHIP_TYPES=standard,household
CONSENT_TEXT_VERSION=1
WAIVER_TEXT_VERSION=1

# NFC. Leave the keys empty to disable cryptographic cards.
# Generate locally. Never commit the values or NFC_KEYS_FILE.
# off | insecure-dev. insecure-dev accepts clonable UID-only cards.
NFC_UID_MODE=off
NFC_MASTER_KEY=
NFC_SDM_META_READ_KEY=
NFC_TRANSPORT_KEY=
NFC_SYSTEM_ID=club-box
NFC_KEYS_FILE=

# Optional read-only Playtomic Third Party API. Set all three, or none.
# Credentials come from Playtomic Manager, Settings, Developer Tools.
# PLAYTOMIC_SYNC_MINUTES=0 syncs only when an admin presses Sync now.
PLAYTOMIC_BASE_URL=https://thirdparty.playtomic.io
PLAYTOMIC_CLIENT_ID=
PLAYTOMIC_CLIENT_SECRET=
PLAYTOMIC_TENANT_ID=
PLAYTOMIC_SYNC_MINUTES=15
PLAYTOMIC_PAGE_SIZE=100
# Playtomic documents about one call per minute. Set 0 only for a local mock.
PLAYTOMIC_MIN_GAP_MS=60000

# console | smtp | postmark
# console prints a redacted line and does not deliver mail. Use it for development.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=

# console | twilio | webhook
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Transactional alerts for a failed entry pulse or a failed Playtomic sync.
# Marketing messages never use these addresses unless the contact opted in separately.
NOTIFY_ADMIN_EMAIL=
NOTIFY_ADMIN_SMS=

# local | memory. memory is wiped when the process stops. Use local for a club.
STORAGE_BACKEND=local
PHOTO_DIR=
# Decoded photo size. The HTTP body limit is 2 MB, so keep this at or below 1 MB.
PHOTO_MAX_BYTES=1048576

# local | s3. Schedule `npm run backup -- backup` on the host. This app does not run cron.
BACKUP_DESTINATION=local
BACKUP_DIR=./data/backups
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# Empty LOG_FILE keeps JSON logs on the process output only.
LOG_FILE=
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_KEEP=5

# Optional first owner. Leave empty and create accounts in Admin after the token login.
# The password is read from the environment and is not stored in this file.
STAFF_BOOTSTRAP_USERNAME=
STAFF_BOOTSTRAP_PASSWORD=
STAFF_BOOTSTRAP_NAME=
SESSION_TTL_HOURS=12

# mock | http | gpio | serial
# gpio needs the optional onoff package on the host that owns the pin.
# serial writes one pulse-entry line. Neither driver locks a door or releases it for fire.
DOOR_GPIO_PIN=
DOOR_GPIO_ACTIVE_HIGH=true
DOOR_SERIAL_PATH=

