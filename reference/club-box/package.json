{
  "name": "bitpadel-club-box",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted reference app for Lightning court booking and LNURL-auth entry.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "card:program": "tsx src/nfc/program-cli.ts",
    "reader:bridge": "tsx src/nfc/bridge-cli.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.2.3",
    "bech32": "^2.0.0",
    "better-sqlite3": "^12.4.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
